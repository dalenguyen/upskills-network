{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:app", "type:web"],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/web"],
      "options": {
        "configFile": "apps/web/vite.config.ts",
        "main": "apps/web/src/main.ts",
        "outputPath": "dist/apps/web/client",
        "tsConfig": "apps/web/tsconfig.app.json",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=4096"
        }
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web:build",
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "web:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "web:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "options": {
        "config": "vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web/tsconfig.editor.json --noEmit"
      }
    },
    "seed-events": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig tsconfig.base.json apps/web/scripts/seed-community-events.ts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "backfill-user-emails": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig tsconfig.base.json apps/web/scripts/backfill-user-emails.ts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "deploy-docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "docker build --platform linux/amd64 -f apps/web/Dockerfile --build-arg VITE_FIREBASE_API_KEY=AIzaSyCJrR1GdAudqeB8JapcSOCA2Ln7CKNL7bU --build-arg VITE_FIREBASE_AUTH_DOMAIN=upskills-network.firebaseapp.com --build-arg VITE_FIREBASE_PROJECT_ID=upskills-network --build-arg VITE_FIREBASE_APP_ID=1:694973978627:web:ac397327a3143b92e99636 -t us-central1-docker.pkg.dev/upskills-network/upskills/web:${BUILD_NUMBER:-latest} .",
          "gcloud auth configure-docker us-central1-docker.pkg.dev --quiet",
          "docker push us-central1-docker.pkg.dev/upskills-network/upskills/web:${BUILD_NUMBER:-latest}"
        ],
        "parallel": false
      }
    },
    "deploy-cloudrun": {
      "executor": "@upskills/gcloud:cloud-run",
      "configurations": {
        "production": {
          "project": "upskills-network",
          "serviceName": "upskills-web",
          "containerImageName": "web",
          "containerRegistry": "us-central1-docker.pkg.dev/upskills-network/upskills",
          "allowUnauthenticated": true,
          "port": 8080,
          "concurrency": 80,
          "minInstances": 0,
          "secrets": [
            "STRIPE_SECRET_KEY=STRIPE_SECRET_KEY:latest",
            "STRIPE_WEBHOOK_SECRET=STRIPE_WEBHOOK_SECRET:latest",
            "LOOKUP_TOKEN_SECRET=LOOKUP_TOKEN_SECRET:latest",
            "MEDIA_SWEEP_SECRET=MEDIA_SWEEP_SECRET:latest",
            "RESEND_API_KEY=RESEND_API_KEY:latest"
          ],
          "envVars": {
            "NODE_ENV": "production",
            "GCP_PROJECT_ID": "upskills-network",
            "SITE_URL": "https://upskillsnetwork.com",
            "EMAIL_FROM": "Upskills Network <dale@updates.upskillsnetwork.com>",
            "MEDIA_BUCKET": "upskills-network-media"
          }
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx deploy-docker web",
          "nx deploy-cloudrun web --configuration production"
        ],
        "parallel": false
      }
    }
  }
}
