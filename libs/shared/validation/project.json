{
  "name": "shared-validation",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/validation/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:validation"
  ],
  "// targets": "to see all targets run: nx show project shared-validation --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/shared/validation/tsconfig.lib.json --noEmit",
          "tsc -p libs/shared/validation/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
